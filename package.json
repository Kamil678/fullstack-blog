{
  "name": "fullstack-blog",
  "version": "1.0.0",
  "description": "Full-stack MERN blog with admin dashboard, comments and Google sign-in",
  "type": "module",
  "main": "backend/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"nodemon backend/index.js\" \"npm run dev --prefix frontend\"",
    "start": "node backend/index.js",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "test": "vitest run",
    "lint": "npm run lint --prefix frontend",
    "seed": "node backend/scripts/seed.js",
    "make-admin": "node backend/scripts/make-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
